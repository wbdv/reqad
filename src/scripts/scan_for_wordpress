#!/usr/bin/env php82
<?php
/*
 * Look for WordPress installs in every account's site folders (main domain,
 * addon domains, subdomains) and bring WP Toolkit's list up to date. The
 * looking is done by core's wordpress_scan() AS each account: nothing of a
 * site (wp-config.php, plugins) ever runs as root here.
 *
 * Called by the 2087 WP Toolkit's "Rescan Wordpress" (in the background, as
 * root through sudo). One account: scan_for_wordpress <user>.
 */
if (php_sapi_name() != 'cli' || posix_getuid() != 0) {
	echo "You can only run this script as root from cli.\n";
	exit(1);
}
if (isset($argv[1]) && $argv[1] === '--help') {
	echo "Scan for WordPress installs in the folders of all sites of every account (or of one)\n";
	echo "Usage: ".$argv[0]." [<user>] [--help]\n";
	exit(0);
}
$only = isset($argv[1]) ? (string)$argv[1] : '';

/* the panel as bin/reqad loads it (at file scope: defines.php makes globals) */
require_once __DIR__.'/../public_html/defines.php';
require_once _PATH.'/public_html/modules/functions.php';
$db->busyTimeout(5000);
foreach (glob(_PATH.'/app/functions/*.php') as $app_functions_file)
	require_once $app_functions_file;
plugins_load();

$users = array();
$res = $db->query('SELECT user FROM accounts ORDER BY user');
while ($res && ($r = $res->fetchArray(SQLITE3_ASSOC)))
	if ($only === '' || $r['user'] === $only)
		$users[] = $r['user'];
if (!$users) {
	echo $only !== '' ? "There is no account '$only'.\n" : "There are no accounts created on this server.\n";
	exit($only !== '' ? 1 : 0);
}

$pad = function ($s, $n) { return mb_substr(str_pad((string)$s, $n + strlen((string)$s) - mb_strlen((string)$s)), 0, $n); };
echo "┌──────────────────────────────────────────────────────────────────────────────────────────────────────────────────┐\n";
echo "│ \033[97m   #   Domain                           WP Version    Title                            Path             Status\033[0m   │\n";
echo "├──────────────────────────────────────────────────────────────────────────────────────────────────────────────────┤\n";
$i = 0;
$failed = 0;
foreach ($users as $user) {
	$r = wordpress_scan($user);
	if (empty($r['ok'])) {
		$failed++;
		echo '│ '.$pad('', 5).'│ '.$pad($user.': '.$r['error'], 105)."│\n";
		continue;
	}
	foreach ($r['data']['sites'] as $s) {
		$i++;
		echo '│ '.$pad(str_pad($i.' ', 5, ' ', STR_PAD_LEFT), 5);
		echo '│ '.$pad($s['domain'], 31);
		echo '│ '.$pad($s['version'], 12);
		echo '│ '.$pad($s['title'], 32);
		echo '│ '.$pad($s['path'] === '' ? '/' : $s['path'], 14);
		echo '│ '.$pad($s['status'], 9).'│'."\n";
	}
}
echo "└──────────────────────────────────────────────────────────────────────────────────────────────────────────────────┘\n";
exit($failed ? 1 : 0);
