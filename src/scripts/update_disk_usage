#!/opt/reqad/php-current/usr/bin/php -c/etc/reqad/php-fpm/php.ini
<?php
/* The shebang pins Reqad's php.ini: the stock php82 CLI ini disables exec(),
   and the mailbox cache refresh below shells out. */
require_once __DIR__.'/../public_html/modules/functions.php';
if(php_sapi_name() != "cli" || posix_getuid() != 0) {
    echo "You can only run this script as root from cli.\n";
    exit;
}
if(!is_file(__DIR__.'/../db/reqad.db')) {
	echo "Missing SQLite Database '".__DIR__."'/../db/reqad.db'\n";
	exit;
}

if(isset($argv) && count($argv)>1) {
	$argp = explode('=', $argv[1]);
	if($argp[0]=='--help') {
		echo "Update users disk usage\n";
		echo "Usage: ".$argv[0]." [--help]\n";
		exit;	
	}
}

$db = new SQLite3(__DIR__.'/../db/reqad.db');

$results = $db->query('SELECT count(*) as nb FROM accounts');
$row = $results->fetchArray();
$nb_accounts = (int)($row["nb"]);
if($nb_accounts == 0) {
	echo "There are no accounts created on this server.\n";
 	exit;
} else {
	$results = $db->query('SELECT * FROM accounts');
	$i=0;
	echo "┌──────────────────────────────────────────────────────────────────────────────────────────────────────┐\n";
	echo "│ \033[97m   #   Domain                           User                Usage                           Status\033[0m   │\n";
	echo "├──────────────────────────────────────────────────────────────────────────────────────────────────────┤\n";
	while ($row = $results->fetchArray()) {
		$i++;
		if($row["status"]!='active') {
			echo "\033[41m"; echo "\033[97m"; // white on red
		}
		echo '│ '.substr(str_pad($row["id"].' ', 5, ' ', STR_PAD_LEFT), 0, 5);
		echo '│ '.substr(str_pad($row["domain"], 31), 0, 31);
		echo '│ '.substr(str_pad($row["user"], 18), 0, 18);
		$disk_usage = shell_exec('du -sm /home/'.$row["user"]);
		$disk_usage = (int)($disk_usage);

/*
			if($row["disk_quota"]>1023)
				if(number_format($row["disk_quota"]/1024*10)%10==0)
					echo '│ '.substr(str_pad(number_format($row["disk_usage"]).' MB of '.number_format($row["disk_quota"]/1024).' GB ('.round($row["disk_usage"]*100/$row["disk_quota"]).'%)', 30), 0, 30);
				else
					echo '│ '.substr(str_pad(number_format($row["disk_usage"]).' MB of '.number_format($row["disk_quota"]/1024,1).' GB ('.round($row["disk_usage"]*100/$row["disk_quota"]).'%)', 30), 0, 30);
			else
				echo '│ '.substr(str_pad(number_format($row["disk_usage"]).' MB of '.number_format($row["disk_quota"]).' MB ('.round($row["disk_usage"]*100/$row["disk_quota"]).'%)', 30), 0, 30);
		}
*/
		if($disk_usage>=1024)
			echo '│ '.substr(str_pad(number_format((int)($disk_usage/1024),0,'.',"'").' GB ', 30, ' ', STR_PAD_LEFT), 0, 30);
		else
			echo '│ '.substr(str_pad(number_format($disk_usage,0,'.',"'").' MB ', 30, ' ', STR_PAD_LEFT), 0, 30);

		$db->query('UPDATE accounts SET disk_usage='.$disk_usage.' WHERE user="'.$row["user"].'"');

		echo '│ '.substr(str_pad($row["status"], 9), 0, 9).'│';
		if($row["status"]!='active')
			echo "\033[0m";
		echo "\n";
	}
	echo "└──────────────────────────────────────────────────────────────────────────────────────────────────────┘\n";
	#	echo "\n";
}

/* Mailbox disk-usage cache (the `emails` table). Same job as the loop above,
   for mail accounts instead of hosting accounts. Refreshing here means the
   Email Accounts page normally serves cached figures instead of running a
   du -skm per mailbox while someone waits for the page. The table is only a
   cache — mailbox_usage_refresh_all() rebuilds it from /etc/dovecot/users and
   drops rows for mailboxes that no longer exist. */
if(is_file('/etc/dovecot/users')) {
	$n = mailbox_usage_refresh_all($db);
	echo "Refreshed disk usage for $n mailbox".($n==1?'':'es').".\n";
}
?>
