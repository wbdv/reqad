#!/opt/reqad/php-current/usr/bin/php -c/etc/reqad/php-fpm/php.ini
<?php
/**
 * reqad — command line interface for the Reqad hosting control panel.
 *
 * The account / database / email commands call the same functions as the web
 * panel (app/functions/*.php), so both do exactly the same thing. Every such
 * command accepts --json for scripting; exit status is 0 on success, 1 when
 * the operation failed and 2 on a usage error.
 */

// App root, resolved relative to this script (bin/ sits directly under it),
// so -V / info work without loading the panel config.
define('REQAD_ROOT', realpath(__DIR__.'/..'));

$prog = basename($argv[0]);

/* Commands that add-ons (plugins) bring, from their cli.txt files:
   "<command>  <summary>" per line. Read without loading the panel, so the help
   and the completion list them; the command itself is in the plugin manifest. */
function cli_plugin_list() {
    $list = array();
    foreach (glob(REQAD_ROOT.'/public_html/plugins/*/cli.txt') ?: array() as $f)
        foreach (file($f, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) ?: array() as $line)
            if (preg_match('/^([a-z][a-z0-9-]*)\s+(\S.*)$/', trim($line), $m))
                $list[$m[1]] = $m[2];
    return $list;
}

/* Subcommands that add-ons add to core commands, from their cli-subs.txt
   files: "<command> <sub> <arguments><TAB><summary>" per line, e.g.
   "account suspend <account> [--reason=TEXT]<TAB>Suspend the account". Read
   without loading the panel, for the help and the completion; the code is the
   manifest's 'cli_subs' => array('<command>' => array('<sub>' => array(
   'opts' => array(...), 'arg' => '', 'run' => fn($prog, $sub, $pos, $opts)))).
   Returns command => sub => array(arguments, summary). */
function cli_plugin_subs() {
    $list = array();
    foreach (glob(REQAD_ROOT.'/public_html/plugins/*/cli-subs.txt') ?: array() as $f)
        foreach (file($f, FILE_IGNORE_NEW_LINES | FILE_SKIP_EMPTY_LINES) ?: array() as $line)
            if (preg_match('/^([a-z][a-z0-9-]*) ([a-z][a-z0-9-]*)([^\t]*)\t+(\S.*)$/', rtrim($line), $m))
                $list[$m[1]][$m[2]] = array(trim($m[3]), $m[4]);
    return $list;
}

/* The add-on subcommands of $cmd, for the end of its help. */
function usage_plugin_subs($prog, $cmd) {
    $subs = cli_plugin_subs()[$cmd] ?? array();
    if (!$subs)
        return;
    $text = "\nFrom add-ons:\n";
    foreach ($subs as $sub => $x)
        $text .= "  {$prog} {$cmd} {$sub}".($x[0] !== '' ? " {$x[0]}" : '')."\n      {$x[1]}\n";
    cli_help(rtrim($text, "\n"));
    echo "\n";
}

function usage($prog) {
    $addons = '';
    foreach (cli_plugin_list() as $c => $summary)
        $addons .= sprintf("  %-16s %s\n", $c, $summary);
    cli_help(<<<HELP
!Reqad — the alternate hosting control panel.

Usage: {$prog} [options]
       {$prog} <command> [arguments] [--json]

Options:
  -h, --help       Show this help and exit
  -V, --version    Show the installed Reqad version and exit

Commands:
  info             Show the web server and installed PHP versions
  account          List, show, create, edit and delete hosting accounts
  db               List, create, delete and export MySQL databases, change passwords
  email            List, create, edit and delete mailboxes
  auth             Panel login: web/basic mode, password, 2FA, sessions, blocked IPs
  health           What needs attention: certificates, mail DNS, PHP versions, services...
  api              REST API: turn it on or off, make and revoke access tokens
  deploy           Git deployments: deploy a site from a branch, roll back, see the log
  app              Node.js / Python apps: run a domain from a process, runtimes, logs
  wordpress        WordPress sites: find them, versions and updates, update, dashboard login
  backup           An account's backups: list them, what is in one, put files, a database or a mailbox back
  stats            Visitor stats and bandwidth per site, counted from the web server logs
  logs             A site's web server log, a day at a time: its requests and errors
  resources        CPU, memory and processes of each account, the limits it reached
  shelllog         Commands run by hosting accounts (SSH, terminal, cron, sites): on/off, list
  dns              DNS cluster health, and the zones this server's sites need (dns zones)
  transfer         cPanel transfers: the history, their logs, the IP map and restoring its addresses
  mcp              AI assistants (MCP): turn on or off, tokens, the server they connect to
{$addons}
Run '{$prog} <command> --help' for the command's own options.

HELP);
}

function usage_account($prog) {
    cli_help(<<<HELP
Usage: {$prog} account list
       {$prog} account show   <user>
       {$prog} account create <user> <domain> [--dns] [--letsencrypt] [--email] [--www]
                                          [--quota=MB] [--php=VERSION|off] [--shell=MODE] [--package=NAME]
                                          [password option]
       {$prog} account edit   <user> [--password] [--php=VERSION[:fpm|mod_php]|off] [--email=on|off]
                                          [--shell=full|jailed|none]
       {$prog} account delete <user> [--yes]
       {$prog} account limits [<user>] [--cpu=%] [--memory=MB|G] [--processes=N] [--default|--none]
                                          [--db-connections=N|default] [--sync-db]
       {$prog} account can-create <user|-> <resource> [--domain=DOMAIN]
       {$prog} account perms  <user> [--fix] [--keep-root]

create:
  --dns             Create the DNS zone at the configured DNS provider
  --letsencrypt     Request a Let's Encrypt certificate (in the background)
  --email           Enable mail for the domain (exim, DKIM, MX/SPF/DMARC)
  --www             Add the www.<domain> alias
  --quota=MB        Disk quota (ignored when quotas are off)
  --php=8.3         PHP version (default: the server's), off = no PHP (static
                    site or app); with mod_php also 8.2:fpm
  --shell=MODE      Shell access, see edit (default: Settings > Security)
  --package=NAME    Hosting package (Reqad Hosting Pro; default: its default package)

edit:
  --password        Set a new password (prompt, or --password-stdin)
  --php=8.3         Switch PHP version; with mod_php also 8.2:mod_php or 8.2:fpm
  --php=off         Disable PHP (pool removed, .php answers 403); a version re-enables it
  --email=on|off    Enable or disable mail for the domain
  --shell=jailed    Shell access for SSH, cron and the web terminal: full (bash),
                    jailed (sandbox: own home only) or none (SFTP only; cron
                    jobs still run, jailed). New accounts get the default from
                    Settings > Security unless create gets --shell too.

limits:
  CPU, memory and processes for the account's SSH, cron and web-terminal
  sessions, all together; website PHP has its own pool settings.
  without a user    The latest hits of all accounts
  without options   Show the limits, what is in use now and recent hits
  --cpu=150         CPU in percent, 100 = one core
  --memory=2G       Memory (MB, or with G); at the cap the kernel kills the
                    account's largest process
  --processes=512   Processes at once; more are refused
  --default         Back to the server defaults (follow them when they change)
  --none            No limits for this account
  Options left out keep their current value. Hits are logged in
  /var/log/reqad/session-limits.log.
  --db-connections=30  Connections at once for each of the account's MySQL
                    users (0 = no limit, default = back to the server default
                    of 30); MariaDB counts per database user, not per account
  --sync-db         Apply the stored database limits again (e.g. after users
                    were made in phpMyAdmin); without <user>: every account

perms checks the owners and permissions of everything in the account's home:
files of other users or of root, foreign groups, world-writable files,
setuid files, wp-config.php / .env readable by everyone, ~/.ssh modes. Exit 0
= fine, 3 = problems found. --fix repairs them (a restore script is written
first, /var/lib/reqad/perms-restore-<user>-<time>.sh) and sets the top folders
and the php-fpm pool by the permissions model; --keep-root leaves root's files
alone (e.g. published files the site must not change).

can-create asks the limits hook whether <user> may create one more <resource>
(account with '-', database, mailbox, forwarder, autoresponder, alias, addon,
cron, ssh_key): exit 0, or exit 1 with the reason. Core has no limits; hosting
packages (a plugin) add them. For scripts, e.g. scripts/adddomain, which passes
--domain so a hosting package can count blog.example.com as a subdomain.

delete removes the vhost, mail, certificates, DNS zone, the home directory and
every database and database user prefixed "<user>_". Databases assigned to
the account (db assign) are kept and become unassigned.

HELP);
    usage_common();
}

function usage_db($prog) {
    cli_help(<<<HELP
Usage: {$prog} db list   [--account=ACCOUNT]
       {$prog} db create <account> <name> [--dbuser=NAME] [password option]
       {$prog} db delete <database> [--yes]
       {$prog} db passwd <dbuser> [password option]
       {$prog} db assign <database> <account>
       {$prog} db unassign <database>
       {$prog} db export <database> [--output=FILE|-] [--no-gzip]

<account> is the hosting account the database belongs to, and it is the
prefix of every name: 'db create bob wp' creates database bob_wp and database
user bob_wp. --dbuser=NAME picks another user name, still prefixed, so
'db create bob wp --dbuser=shop' creates database bob_wp and user bob_shop.
delete and passwd take the full, prefixed name (bob_wp). Users left without
any database are dropped with it.

assign gives a database without an account prefix (imported, made in
phpMyAdmin) to an account, so it is listed and backed up with it; unassign
removes that again. Neither renames nor changes the database.

export saves a database as SQL (mysqldump: one consistent snapshot, routines
and triggers, no CREATE DATABASE, so it loads into a database of any name),
gzip-compressed, as ./<database>-<date>.sql.gz unless --output names the file
(made with mode 0600, never overwritten). --output=- writes it to standard
output, for a pipe. --no-gzip = plain SQL.

HELP);
    usage_common();
}

function usage_email($prog) {
    cli_help(<<<HELP
Usage: {$prog} email list   [--domain=DOMAIN]
       {$prog} email create <address> [--size=SIZE] [password option]
       {$prog} email edit   <address> [--password] [--enable|--disable] [--size=SIZE]
       {$prog} email delete <address> [--yes]
       {$prog} email sites  <account>
       {$prog} email site   <domain> on|off [--no-cert]
       {$prog} email webmail-links [--remove]

edit:
  --password        Set a new password (prompt, or --password-stdin)
  --disable         Block IMAP/POP3/SMTP login (mail is still delivered)
  --enable          Allow login again

create and edit:
  --size=SIZE       Mailbox size, e.g. 500M or 2G; default = the account's
                    default (Reqad Hosting Pro; see 'reqad package mail')

delete also removes the mailbox's messages, filters and autoresponder.

sites             The account's sites and their email: on, off, or missing (the
                  site should have email but has none: 'site <domain> on' fixes it).
site              Turn email on or off for an addon domain or subdomain (the main
                  domain follows the account: 'account edit --email=on|off').
                  New addon domains get email, new subdomains do not. off is
                  refused while the site has mailboxes; its forwarders and
                  autoresponders go, and when its DNS is at the DNS provider and
                  its mail came here, its MX and DKIM records go and SPF says it
                  sends no mail. A Let's Encrypt certificate is issued again to
                  add or drop mail.<domain> (--no-cert: leave it as it is).
webmail-links     Every site of an account with email sends /webmail to
                  https://<hostname>:2087/webmail/ (Settings > Webmail address,
                  on by default; runs every hour). --remove takes it out of
                  every site.

HELP);
    usage_common();
}

function usage_auth($prog) {
    cli_help(<<<HELP
Usage: {$prog} auth status
       {$prog} auth mode     [status|web|basic]
       {$prog} auth passwd   [<user>] [password option]
       {$prog} auth 2fa-reset [<user>]
       {$prog} auth sessions
       {$prog} auth logout   [<user>]
       {$prog} auth unban    <ip>
       {$prog} auth firewall [status|off]
       {$prog} auth email-code [status|off|on]
       {$prog} auth passkeys [<user>] [--remove-all]
       {$prog} auth log      [--lines=N]

mode            Show the current login mode (same as 'mode status').
mode web        Replace the browser's password prompt on port 2087 with the login
                page: sessions, two-factor authentication, lockouts and csf bans
                for repeated failures. Existing nginx_auth passwords keep working.
mode basic      Go back to nginx basic auth (same password).
passwd          Set an admin password (creates the admin if missing; default user:
                the only admin). Also updates nginx_auth. Logs out its sessions.
2fa-reset       Turn two-factor authentication off - for a lost phone.
logout          End every session (of <user>, or of everyone).
unban           Unblock an IP that failed to log in too often (app lockout + csf).
firewall off    Open port 2087 to every address again when the panel's IP allowlist
                (Settings > Security) keeps you out. The saved list is kept.
email-code off  Stop asking new devices for the emailed login code - when the code
                does not arrive. It is asked for when 2FA is off and the panel can
                send email and its switch (Settings > Security > New devices) is
                on; 'on' turns it back on.
passkeys        List the passkeys that can log in as <user>; --remove-all deletes
                them (a lost or stolen device). The password keeps working.

These are the way back in when you are locked out of the panel.

HELP);
    usage_common();
}

function usage_health($prog) {
    cli_help(<<<HELP
Usage: {$prog} health list    [--account=ACCOUNT] [--all] [--json]
       {$prog} health run     [--check=ID] [--quiet]
       {$prog} health checks
       {$prog} health dismiss <id> [--days=N|--forever]
       {$prog} health restore <id>

list            The problems the last run found, most severe first (the dashboard's
                "Needs attention" card). --account: one account only ('-' = the
                server's own); --all: dismissed ones too.
run             Run the checks now and store the result. Cron runs them every 30
                minutes; --check=ID runs one check (see 'checks').
checks          The checks there are.
dismiss         Hide a problem from the card and the list for 7 days, --days=N, or
                --forever. It shows again when the time is up.
restore         Show a dismissed problem again.

HELP);
    usage_common();
}

function usage_api($prog) {
    cli_help(<<<HELP
Usage: {$prog} api status
       {$prog} api on|off
       {$prog} api tokens  [--all]
       {$prog} api new     <name> [--account=ACCOUNT] [--write] [--delete] [--days=N] [--ip=LIST]
       {$prog} api revoke  <id|name|prefix>
       {$prog} api log     [--lines=N] [--token=ID]

status          Whether the API answers, its address and the tokens in use.
on / off        Turn the API on or off (https://<host>:2087/api/v1/). Off: every
                request gets 403; the tokens are kept.
tokens          The tokens: permissions, account, expiry, last use. --all: revoked
                ones too.
new             Make a token and print it - the only time it is shown. It can read
                everything; --write adds create and change, --delete adds delete.
                --account: it acts only on what that hosting account owns.
                --days=N: expires after N days (default 90, 0 = never).
                --ip: only from these addresses or networks (comma separated).
revoke          Refuse the token from now on.
log             The latest API calls (default 30).

HELP);
    usage_common();
}

function usage_wordpress($prog) {
    cli_help(<<<HELP
Usage: {$prog} wordpress list   [--account=ACCOUNT]
       {$prog} wordpress scan   <account>
       {$prog} wordpress show   <site> [--refresh]
       {$prog} wordpress update <site> [--core] [--plugins[=LIST]] [--themes[=LIST]]
       {$prog} wordpress login  <site>
       {$prog} wordpress auto   <site> [--core=off|minor|all] [--plugins=off|all|LIST]
                                [--themes=off|all|LIST] [--when=daily|sun..sat] [--hour=H] [--wait=DAYS] [--off]
       {$prog} wordpress auto-run [--quiet]
       {$prog} wordpress cache  <site> [--pages=LIST] [--cookies=LIST]
       {$prog} wordpress cache-refresh [--dry-run] [--quiet]

<site> is the id from 'list', a domain, a domain with the folder of the
install (example.com/blog) or an account name (its first site).

scan            Look for the account's WordPress installs in the folders of all
                its sites (main, addon domains, subdomains) and update the list.
show            Version, core / plugin / theme updates, plugins and themes, read
                live from the site. --refresh asks wordpress.org again first.
update          Save the database to the account's ~/wp-backups/, then update
                WordPress (--core), plugins and themes (all with an update, or
                the comma-separated folder names given) and empty the caches.
login           A one-time link to the site's dashboard (first administrator),
                valid for 2 minutes.
auto            Auto-updates of the site: without options it shows them; with
                options it changes them (--core=minor: security and fix releases
                only; LIST = comma-separated folder names; --when and --hour in
                the server's time; --wait: days a release must be old; --off:
                all off). Each run saves the database, leaves out updates that
                need a newer PHP and puts plugins and themes back if the home
                page stops opening.
auto-run        Start the auto-update runs that are due (cron, every 15 minutes).
cache           The site's own page cache rules: without options it shows them;
                --pages = paths that are never cached (comma-separated, each
                starts with /, * = any text), --cookies = cookie names that turn
                the cache off (name* = every cookie starting so). A list given
                replaces that list; --pages= (empty) clears it.
cache-refresh   Write the page cache blocks of every site that has the cache on
                again, from the current version and the sites' rules (update
                script update_wp_cache_blocks.sh). One nginx reload at the end;
                the old files are kept in /var/lib/reqad/vhost-backups/.

HELP);
}

function usage_backup($prog) {
    cli_help(<<<HELP
Usage: {$prog} backup list     <account> [--refresh]
       {$prog} backup show     <account> <backup>
       {$prog} backup restore  <account> <backup> --files=PATH|--database=NAME|--email=MAILBOX
                               [--mode=MODE] [--name=NEW_DB] [--grant=DBUSER]
       {$prog} backup restores <account>

list            The account's backups, newest first: the nightly ones on the backup
                server (remote-YYYYMMDD) and archives in /usr/local/reqad/backup
                (local-YYYYMMDD-HHMM). --refresh asks the backup server again.
show            What one backup holds: its databases, mailboxes and top folders.
restore         Put something back, in the background (the same as the account panel's
                Backups pages):
                  --files=PATH      a file or folder of the home folder ('' = all of
                                    it, without mail); --mode=missing (default: only
                                    what is not there now), overwrite or replace
                  --database=NAME   one of the backup's databases; --mode=tables
                                    (default), replace, or new with --name (and
                                    --grant to give it to a database user)
                  --email=MAILBOX   one mailbox; --mode=missing (default) or replace
                What is replaced is kept in the account's ~/backup-restores/.
restores        The latest restores of the account and how they ended.

HELP);
}

function usage_stats($prog) {
    cli_help(<<<HELP
Usage: {$prog} stats show    <domain|all> [--period=30d|12m|YYYY-MM] [--account=USER]
       {$prog} stats usage   [--month=YYYY-MM]
       {$prog} stats collect [--domain=DOMAIN] [--quiet]
       {$prog} stats geoip   [--update] [--auto] [--monthly=on|off] [--quiet]
       {$prog} stats on|off

show            Visitors, page views, requests, bandwidth and server errors of a
                site per day (12m: per month), with its top pages, referring
                sites, missing pages, bots and countries. 'all' = every site of
                --account. Default period: the last 30 days.
usage           Bandwidth and visitors of every account and its sites in a month,
                busiest first (the same as Accounts > Bandwidth Usage).
collect         Count what the sites' logs got since the last count. Cron runs it
                every hour; a log seen for the first time is read with its
                rotated copies of the last 60 days.
geoip           The country database in use. --update downloads this month's
                DB-IP Lite database now (CC BY 4.0); --auto does it only when the
                monthly update is on and the file is older than this month (cron,
                monthly); --monthly=on|off turns the monthly update on or off.
on, off         Turn visitor stats on or off for the whole server (on by default).
                Off: nothing is counted; what was counted stays.

No visitor's address is stored: visitors are counted per day with a hash
that cannot be turned back into an address.

HELP);
}

function usage_shelllog($prog) {
    cli_help(<<<HELP
Usage: {$prog} shelllog status
       {$prog} shelllog on      [--days=7|30|90|180]
       {$prog} shelllog off
       {$prog} shelllog days    <7|30|90|180>
       {$prog} shelllog accounts
       {$prog} shelllog show    <account> [--day=YYYY-MM-DD] [--source=SRC] [--flagged] [--q=TEXT]
                                          [--admin] [--page=N]
       {$prog} shelllog collect [--quiet]

status          On or off, the days kept, the last read of the audit log.
on, off         Log every program the hosting accounts start (auditd rule
                /etc/audit/rules.d/reqad-commands.rules). Off by default. Off
                removes the rule; what was logged stays for the days kept.
days            How long logged commands are kept (default 30).
accounts        Every account: commands in 24 hours and 7 days, red flags, the
                newest command (Accounts & Domains > Shell Activity).
show            One account's commands, newest first. --source=ssh, terminal,
                cron, web, account, login or admin; without it admin rows (root
                or an admin running something as the account) are left out
                unless --admin. --flagged: only red flags.
collect         Read the audit log since the last time. Cron runs it every minute.

Programs are logged by the kernel, also inside the jailed shell; shell
builtins (cd, echo > file) start no program and are not seen. The same command
again within the hour adds to one line (x N).

HELP);
}

function usage_transfer($prog) {
    cli_help(<<<HELP
Usage: {$prog} transfer list
       {$prog} transfer show       <transfer>
       {$prog} transfer log        <transfer> [<account>]
       {$prog} transfer ip-map     <transfer>
       {$prog} transfer ip-restore <transfer>|<file> [--apply]

Transfers from cPanel are made on the panel's Transfer tool page; each one is
kept with its logs in /usr/local/reqad/transfers/. <transfer> is the id that
'list' shows (or 'latest').

list            Every transfer, newest first: when, from where, its accounts, how it ended.
show            One transfer: each account's state and its own log.
log             The whole log of a transfer (its own, then each account's), or one
                account's.
ip-map          The IP map of a transfer: the address each site had on the cPanel
                server and the address its mail went out from, one line per site.
                Save it ('> file') to keep it; lines can be edited or removed.
ip-restore      What restoring an IP map would do, and with --apply do it: once the
                cPanel server's addresses are on this server (Settings > IP
                addresses), each account gets back the address that was its own on
                cPanel, and domains whose mail went out from another address get an
                outgoing mail rule for it, so DNS can stay as it is. Addresses
                shared by several accounts are not given to one: every site answers
                on every address of this server. Needs Hosting Pro. Logged in
                /usr/local/reqad/transfers/ip-restores.log.

HELP);
}

function usage_dns($prog) {
    cli_help(<<<HELP
Usage: {$prog} dns status
       {$prog} dns check [--wait=SECONDS] [--registry] [--quiet]
       {$prog} dns zones [--all] [--plain] [--export=DIR]

status          The DNS cluster as the last check saw it (Settings > DNS Settings >
                Cluster): this server, each secondary, the registries.
check           Check the cluster now and keep the result (cron runs it every
                5 minutes): every zone's serial on each secondary, UDP and TCP
                answers, a test change timed until each secondary has it
                (--wait: how long to wait for it, default 45), zone transfers
                and recursion refused to others; once an hour (or with
                --registry) where each domain points at its registry.
                Needs dnscluster=1 in server-software.ini and a secondary.
zones           The DNS zones this server's sites need (main, addon and alias
                domains, mail domains), for moving its DNS to another Reqad
                server: import them there, then paste the list into "Zones
                already here" when you make this server's DNS API key (the
                list: --plain). Shows whether each zone is at this server's
                DNS provider now.
                --all: also the provider's zones no site uses. --plain: only
                the zone names, one per line. --export=DIR: write each zone
                that is at the provider as DIR/<zone>.db (zone files for DNS
                Zones > Import zone). Works without dnscluster=1.

HELP);
}

function usage_resources($prog) {
    cli_help(<<<HELP
Usage: {$prog} resources usage     [--range=day|week|month]
       {$prog} resources show      <account> [--range=day|week|month]
       {$prog} resources processes <account>
       {$prog} resources stop      <account> <pid> --start=TICKS
       {$prog} resources collect   [--quiet]

usage           CPU, memory and processes of every account and of the whole
                server, busiest first (the same as Accounts > Resource Usage).
                Default range: the last 24 hours.
show            One account: its sessions (SSH, cron, terminal), each site's
                PHP, email and background jobs, PHP workers per site, database
                connections per user, the limits it reached and its limits.
processes       What the account runs now, with CPU over the last minute.
stop            Stop one of its processes (TERM, then KILL after 5 seconds);
                --start is the start time 'processes --json' shows, so a pid
                used again by another process is never hit.
collect         One check of every account. Cron runs it every minute.

CPU: 100% = one core. Memory: what the processes hold, a page several of
them share counted once.

HELP);
}

function usage_logs($prog) {
    cli_help(<<<HELP
Usage: {$prog} logs site <domain> [--day=YYYY-MM-DD] [--filter=all|err|5xx] [--bots=no]
                                  [--q=TEXT] [--ip=ADDRESS] [--offset=N]
       {$prog} logs site <domain> --errors [--day=YYYY-MM-DD] [--all-lines]
       {$prog} logs days <domain>

site            The requests of a day in the site's web server log, newest first,
                50 at a time (--offset=N skips the newest N): --filter=err only
                4xx and 5xx answers, 5xx only server errors; --bots=no leaves bots
                and scanners out; --q only requests with that text in the address,
                IP, browser or referrer; --ip only that address. Default: today.
                --errors: the web server's errors for the site that day, grouped
                by kind (newest lines with --all-lines).
days            The days the server still keeps (logrotate's daily copies).

The log itself is /var/log/nginx/<domain>_log (Apache: /var/log/httpd/), rotated
every day. Accounts see the same in their panel, Metrics > Logs.

HELP);
}

function usage_deploy($prog) {
    cli_help(<<<HELP
Usage: {$prog} deploy list     [--account=ACCOUNT]
       {$prog} deploy show     <id|domain> [--secret]
       {$prog} deploy create   <domain> --repo=URL [settings]
       {$prog} deploy edit     <id|domain> [settings] [--new-secret]
       {$prog} deploy run      <id|domain> [--wait]
       {$prog} deploy rollback <id|domain> [--release=NAME] [--wait]
       {$prog} deploy log      <id|domain> [--run=ID]
       {$prog} deploy delete   <id|domain> [--yes]

create          Deploy <domain> (a main or addon domain) from Git. It prints the
                deploy key to give the repository read access to, and the
                webhook address + secret for deploys on push. Nothing is changed
                on the site until the first 'run'.
run             Fetch the branch, build it as the account in a new release and
                switch the site to it. --wait shows the output until it ends.
rollback        Switch back to the release before the current one, or --release.
log             The output of the last run (or --run=ID).
delete          Stop deploying. The site keeps running from its last release.

Settings (create and edit):
  --repo=URL        https://host/you/site.git or git@host:you/site.git
  --branch=NAME     the branch to deploy (default main)
  --dir=PATH        the folder in the repository the web serves (default: its root)
  --build=COMMANDS  run in the new release, as the account; e.g.
                    "composer install --no-dev" or "npm ci && npm run build"
  --shared=LIST     paths kept between releases, comma separated; end folders with /
                    e.g. ".env,storage/,wp-content/uploads/"
  --keep=N          releases kept for rolling back (default 5)
  --check=PATH      after the switch, this page must answer 2xx/3xx or the deploy
                    goes back to the previous release (e.g. /)
  --auto=on|off     deploy when the webhook reports a push (default on)

HELP);
    usage_common();
}

function usage_app($prog) {
    cli_help(<<<HELP
Usage: {$prog} app list      [--account=ACCOUNT]
       {$prog} app show      <id|domain>
       {$prog} app create    <domain> --runtime=node:24|python:3.12 [--start=CMD] [settings]
       {$prog} app edit      <id|domain> [settings]
       {$prog} app start|stop|restart <id|domain>
       {$prog} app logs      <id|domain> [--lines=N]
       {$prog} app env       <id|domain> [--file=PATH]
       {$prog} app install   <id|domain> [--wait]
       {$prog} app detect    <domain> [--dir=PATH] [--runtime=node|python]
       {$prog} app delete    <id|domain> [--yes]
       {$prog} app runtimes  [--available]
       {$prog} app runtime   install|update|remove node <major> | python <3.x>

create          Serve <domain> (a main or addon domain) from a process of the account:
                the start command runs in the app folder with PORT and HOST set, and
                nginx proxies the domain to it (websockets too). PHP is off for the
                domain until the app is deleted. The app restarts after every Git
                deploy of the domain.
env             Print the app's environment file, or replace it with --file (KEY=value
                lines) and restart the app.
install         Install the app's packages as the account, in the background, then
                restart it. Python: its own .venv (made again when the app's Python
                version changed), requirements.txt, else pyproject.toml, else
                setup.py, plus the server the start command names (gunicorn,
                uvicorn...). Node.js: npm ci (or npm install), then npm run build if
                package.json has a build script. --wait: follow the output.
detect          Look at the code (as the account; nothing runs) and print the start
                command it needs: Django, Flask, FastAPI and other Python apps,
                Next.js, Nuxt, SvelteKit, NestJS, package.json's start script... The
                folder: --dir, else the app's, else the Git deployment's current
                release, else apps/<domain>/app. --runtime: that kind's commands first.
runtimes        Installed Node.js and Python versions; --available: Node.js majors
                that can be installed.
runtime         Install a Node.js major (official build, checksum verified) or a
                Python version (OS packages). update restarts the apps using it.

Settings (create and edit):
  --runtime=KIND:VERSION  node:24, node:22, python:3.12, ...
  --start=CMD             e.g. "node server.js", "npm start",
                          ".venv/bin/gunicorn -b 127.0.0.1:\$PORT app:app" (see app detect;
                          required, except for a Git deployment with no release yet:
                          the first deploy finds it)
  --dir=PATH              the app folder in the account's home (default: the Git
                          deployment's current release, else apps/<domain>/app)
  --static=on|off         nginx serves files that exist in the document root first
  --memory=MB             memory limit (default 512)

HELP);
    usage_common();
}

function usage_mcp($prog) {
    cli_help(<<<HELP
Usage: {$prog} mcp status
       {$prog} mcp on|off
       {$prog} mcp tokens  [--all]
       {$prog} mcp new     <name> [--account=ACCOUNT] [--write] [--delete] [--days=N] [--ip=LIST]
       {$prog} mcp revoke  <id|name|prefix>
       {$prog} mcp log     [--lines=N] [--token=ID]
       {$prog} mcp tools   [--token-file=PATH]
       {$prog} mcp serve   --token-file=PATH

AI assistants (Claude, Cursor and other MCP clients) manage this server with
the same operations as the REST API. The assistant logs in over SSH as root
and runs 'reqad mcp serve'; the token decides what it may do.

status          Whether AI access is on, and the tokens in use.
on / off        Turn AI access on or off. Off: assistants cannot connect, running
                sessions stop at their next call; the tokens are kept.
tokens          The AI access tokens. --all: revoked ones too.
new             Make a token and print the settings for the assistant. It can read
                everything; --write adds create and change (accounts, databases,
                mailboxes, restarts, deploys), --delete adds delete - every delete
                still needs a second, confirmed call. --account: only what that
                hosting account owns. --days=N: expires after N days (default 30,
                at most 90). --ip: only from these SSH client addresses.
                The token is saved in /var/lib/reqad/mcp/<id>.token (root only).
revoke          Refuse the token from now on, also in running sessions.
log             The latest tool calls (default 30).
tools           The tools assistants get; with --token-file only that token's.
serve           Speak MCP on stdin/stdout (what the assistant runs over SSH).

HELP);
    usage_common();
}

function usage_common() {
    echo "\n";
    cli_help(<<<HELP
Password option (passwords are never taken as an argument):
  (none)                 Prompt for it (twice) when run from a terminal
  --password-stdin       Read it from the first line of standard input
  --generate-password    Generate a random one and print it

Common:
  --json            Print the result as JSON
  -y, --yes         Do not ask for confirmation (required for delete without a terminal)
  --user=ACCOUNT    Act as this hosting account: only its own databases, mailboxes and
                    settings (what account-level access - API tokens, the account
                    panel - will be allowed). Admin-only commands are refused.

HELP);
}

/**
 * Locate an executable, preferring an absolute fallback path when the PATH
 * lookup fails (the CLI may run with a minimal environment).
 */
function find_bin($name, $fallback = '') {
    $path = trim(shell_exec('command -v '.escapeshellarg($name).' 2>/dev/null'));
    if ($path !== '') return $path;
    if ($fallback !== '' && is_executable($fallback)) return $fallback;
    return '';
}

/* Full version (e.g. 7.4.33) of an installed PHP: the CLI binary, else php-fpm.
   -n skips php.ini and extensions, so each call stays fast. */
function php_full_version($pv, $default) {
    $root = ($pv === $default) ? '/usr' : '/opt/remi/php'.str_replace('.', '', $pv).'/root/usr';
    foreach (array($root.'/bin/php', $root.'/sbin/php-fpm') as $bin) {
        if (!is_executable($bin)) continue;
        $raw = (string)shell_exec(escapeshellarg($bin).' -n -v 2>/dev/null');
        if (preg_match('#^PHP (\d+\.\d+\.\d+\S*)#', $raw, $m)) return $m[1];
    }
    return $pv;
}

function show_info() {
    $ini = parse_ini_file(REQAD_ROOT.'/etc/server-software.ini');
    if ($ini === false) {
        fwrite(STDERR, "reqad: unable to read etc/server-software.ini\n");
        exit(1);
    }

    // OS pretty name from /etc/os-release (it is ini-formatted, so parse_ini_file
    // strips the surrounding quotes for us).
    $osr = @parse_ini_file('/etc/os-release');
    $os  = ($osr && !empty($osr['PRETTY_NAME'])) ? $osr['PRETTY_NAME'] : 'unknown';
    echo "OS:          {$os}\n";

    // info runs before the panel bootstrap; functions.php loads on its own
    require_once REQAD_ROOT.'/public_html/modules/functions.php';
    $template = trim($ini['template'] ?? '');
    $modphp   = (php_mode($ini) === 'modphp');

    // Web server type follows the configured template; the version comes from
    // the running binary (-v writes to stderr, hence the 2>&1).
    if (web_front($ini) === 'httpd') {
        $server = 'Apache';
        $bin    = find_bin('httpd', '/usr/sbin/httpd');
        $raw    = $bin ? shell_exec(escapeshellarg($bin).' -v 2>&1') : '';
        $ver    = preg_match('#Apache/(\S+)#', (string)$raw, $m) ? $m[1] : '?';
    } else {
        $server = 'nginx';
        $bin    = find_bin('nginx', '/usr/sbin/nginx');
        $raw    = $bin ? shell_exec(escapeshellarg($bin).' -v 2>&1') : '';
        $ver    = preg_match('#nginx/(\S+)#', (string)$raw, $m) ? $m[1] : '?';
    }

    echo "Web server:  {$server} {$ver}  (template: ".($template !== '' ? $template : 'unset').")\n\n";

    $default      = trim($ini['php'] ?? '');
    $php_versions = array_map('trim', explode(',', $ini['php_versions'] ?? ''));
    $php_versions = array_filter($php_versions, 'strlen');

    if (!$php_versions) {
        echo "Installed PHP: none\n";
        return;
    }

    echo "Installed PHP:\n";
    foreach ($php_versions as $pv) {
        // Under nginx everything runs via php-fpm; under apache the default
        // version is served by mod_php, the rest via php-fpm.
        $handler = (!$modphp || $pv != $default) ? 'php-fpm' : 'mod_php';

        $tag = ($pv == $default) ? '  (default)' : '';
        printf("  %-8s %-8s %s\n", php_full_version($pv, $default), $handler, $tag);
    }
}

function show_version() {
    include REQAD_ROOT.'/public_html/modules/version.php';
    if (!isset($reqad_version) || !is_array($reqad_version)) {
        fwrite(STDERR, "reqad: unable to determine version\n");
        exit(1);
    }
    echo 'Reqad '.$reqad_version[0].' ('.$reqad_version[1].")\n";
}

/* ---- helpers for the management commands -------------------------------- */

function cli_die($msg, $code = 2) {
    fwrite(STDERR, "reqad: $msg\n");
    exit($code);
}

/* Split arguments into positionals and --options. "--name=value" gives a
   string, a bare "--name" gives true; -y and -h are the only short options. */
function cli_parse(array $args) {
    $pos  = array();
    $opts = array();
    foreach ($args as $a) {
        if ($a === '-y')       $opts['yes'] = true;
        elseif ($a === '-h')   $opts['help'] = true;
        elseif (substr($a, 0, 2) === '--') {
            $kv = explode('=', substr($a, 2), 2);
            $opts[$kv[0]] = isset($kv[1]) ? $kv[1] : true;
        } elseif ($a !== '' && $a[0] === '-')
            cli_die("unknown option '$a'");
        else
            $pos[] = $a;
    }
    return array($pos, $opts);
}

/* Reject options the subcommand does not know, so a typo is not silently ignored. */
function cli_allow(array $opts, array $allowed) {
    $allowed = array_merge($allowed, array('json', 'help', 'user'));
    foreach (array_keys($opts) as $k)
        if (!in_array($k, $allowed, true))
            cli_die("unknown option '--$k'");
}

function cli_need(array $pos, $n, $what) {
    if (count($pos) < $n)
        cli_die("missing argument: $what");
    if (count($pos) > $n)
        cli_die("unexpected argument '".$pos[$n]."'");
}

function cli_is_tty() {
    return function_exists('posix_isatty') && posix_isatty(STDIN);
}

function cli_read_hidden($prompt) {
    fwrite(STDERR, $prompt);
    shell_exec('stty -echo < /dev/tty');
    $line = fgets(STDIN);
    shell_exec('stty echo < /dev/tty');
    fwrite(STDERR, "\n");
    return rtrim((string)$line, "\r\n");
}

/* Get a password without ever putting it in argv (visible in `ps` and shell
   history). Returns array(password, generated?). */
function cli_password(array $opts, $what) {
    if (isset($opts['password']) && $opts['password'] !== true)
        cli_die("passwords are not accepted as arguments; use --password-stdin, --generate-password or the prompt");
    if (!empty($opts['generate-password']))
        return array(mailbox_random_password(20), true);
    if (!empty($opts['password-stdin'])) {
        $pw = rtrim((string)fgets(STDIN), "\r\n");
        if ($pw === '')
            cli_die("empty password on standard input");
        return array($pw, false);
    }
    if (!cli_is_tty())
        cli_die("no terminal to prompt for the $what password; use --password-stdin or --generate-password");
    $pw = cli_read_hidden("New $what password: ");
    if ($pw !== cli_read_hidden("Retype the password: "))
        cli_die("passwords do not match", 1);
    return array($pw, false);
}

/* Destructive commands: --yes, or type the name back at a terminal. */
function cli_confirm(array $opts, $name, $what) {
    if (!empty($opts['yes']))
        return;
    if (!cli_is_tty())
        cli_die("refusing to delete $what $name without --yes (no terminal to confirm on)");
    fwrite(STDERR, "This permanently deletes $what $name. Type '$name' to confirm: ");
    if (trim((string)fgets(STDIN)) !== $name)
        cli_die("not confirmed, nothing was deleted", 1);
}

/* Print a result_ok()/result_error() array and exit with its status. */
function cli_result(array $r, array $opts, $generated_password = null) {
    if ($generated_password !== null && $r['ok'])
        $r['data']['password'] = $generated_password;
    if (!empty($opts['json'])) {
        echo json_encode($r, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE)."\n";
        exit($r['ok'] ? 0 : 1);
    }
    if (!$r['ok'])
        cli_die($r['error'], 1);
    echo $r['message']."\n";
    if ($generated_password !== null)
        echo "Password: $generated_password\n";
    foreach ($r['warnings'] as $w)
        fwrite(STDERR, "warning: $w\n");
    exit(0);
}

/* Colors only on a terminal (never in --json or a pipe), and NO_COLOR
   (https://no-color.org) turns them off. */
function cli_colors() {
    static $on = null;
    if ($on === null)
        $on = getenv('NO_COLOR') === false && function_exists('posix_isatty') && posix_isatty(STDOUT);
    return $on;
}

function cli_white($s) { return cli_colors() ? "\033[97m".$s."\033[0m" : $s; }
function cli_grey($s)  { return cli_colors() ? "\033[90m".$s."\033[0m" : $s; }

/* Print help text: headings (a line ending in ':' with no two-space column
   gap, the "Usage:" label, or a line marked with a leading '!') in white, descriptions and prose in grey.
   The usage block itself stays plain so the syntax stands out. */
function cli_help($text) {
    $in_usage = false;
    foreach (explode("\n", $text) as $i => $line) {
        if ($i > 0) echo "\n";
        if (trim($line) === '') { $in_usage = false; echo $line; continue; }
        if ($line[0] === '!')
            echo cli_white(substr($line, 1));
        elseif (strpos($line, 'Usage:') === 0) {
            $in_usage = true;
            echo cli_white('Usage:').substr($line, 6);
        } elseif ($in_usage)
            echo $line;
        elseif ($line[0] !== ' ' && substr($line, -1) === ':' && strpos($line, '  ') === false
                && strlen($line) <= 64 && strpos($line, '. ') === false)
            echo cli_white($line);              // "create:" - a short heading, not a sentence
        elseif (preg_match('/^(\s*\S.*?)(\s{2,})(\S.*)$/', $line, $m))
            echo $m[1].$m[2].cli_grey($m[3]);   // "  --opt      description" or "mode web    description"
        else
            echo cli_grey($line);               // prose paragraph
    }
}

/* Display width, so box borders line up with multibyte text. */
function cli_width($s) {
    $s = preg_replace('/\033\[[0-9;]*m/', '', (string)$s);   // colour codes take no room
    return function_exists('mb_strwidth') ? mb_strwidth($s, 'UTF-8') : strlen($s);
}

/* A box-drawn table (same style as scripts/scan_for_wordpress); $cols maps
   header => row key. */
function cli_table(array $rows, array $cols) {
    if (!$rows) {
        echo "(none)\n";
        return;
    }
    $w   = array();
    $num = array();   // all-numeric columns (UID, SIZE_MB) are right-aligned
    foreach ($cols as $h => $k) {
        $w[$k]   = cli_width($h);
        $num[$k] = true;
        foreach ($rows as $r) {
            $w[$k] = max($w[$k], cli_width($r[$k]));
            if (!is_numeric($r[$k])) $num[$k] = false;
        }
    }
    $rule = function($l, $m, $r) use ($w) {
        $parts = array();
        foreach ($w as $n) $parts[] = str_repeat('─', $n + 2);
        return $l.implode($m, $parts).$r."\n";
    };
    $line = function($vals, $head = false) use ($cols, $w, $num) {
        $cells = array();
        foreach (array_values($cols) as $k) {
            $v   = (string)$vals[$k];
            $pad = str_repeat(' ', $w[$k] - cli_width($v));
            $v   = $num[$k] ? $pad.$v : $v.$pad;
            $cells[] = ' '.($head ? cli_white($v) : $v).' ';
        }
        return '│'.implode('│', $cells)."│\n";
    };
    echo $rule('┌', '┬', '┐');
    echo $line(array_combine(array_values($cols), array_keys($cols)), true);
    echo $rule('├', '┼', '┤');
    foreach ($rows as $r)
        echo $line($r);
    echo $rule('└', '┴', '┘');
}

function cli_list(array $rows, array $opts, array $cols) {
    if (!empty($opts['json'])) {
        echo json_encode(result_ok('', $rows), JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES | JSON_UNESCAPED_UNICODE)."\n";
        exit(0);
    }
    cli_table($rows, $cols);
    exit(0);
}

/* ---- command table ------------------------------------------------------ */

/*
