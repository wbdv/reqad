#!/bin/bash
#
# adddomain — create an additional (addon) domain for an existing Reqad account.
#
# The additional domain reuses the account's system user, but gets its own
# document root (/home/<user>/<domain>), its own vhost file and, when it runs a
# different PHP version than the account's main domain, its own php-fpm pool.
#
# Every web server template is supported:
#   apache_*              vhost in /etc/httpd/conf.d/, PHP via mod_php (default) or fpm
#   nginx_php-fpm         vhost in /etc/nginx/conf.d/, PHP always via fpm
#   nginx_apache_php-fpm  nginx vhost in front (static files, certificate), Apache
#                         vhost behind it on loopback (.htaccess, PHP via fpm)
#
# Nothing is written to db/reqad.db: the accounts table has a unique index on
# both `user` and `domain`, so an addon domain cannot live there. The vhost file
# <conf.d>/<domain>.conf is the source of truth.
#
set -u

PATH_REQAD="$(cd "$(dirname "$0")/.." && pwd)"
INI="${PATH_REQAD}/etc/server-software.ini"
DB="${PATH_REQAD}/db/reqad.db"

USER=''
DOMAIN=''
DOCROOT=''
PHPVER=''
HANDLER=''
WWW=1
SSL=1
LETSENCRYPT=0
DRYRUN=0
DOCROOT_READY=0

usage() {
    cat <<EOF
Create an additional domain for an existing hosting account.

Usage: $0 --user=USERNAME --domain=EXAMPLE.TLD [options]

Options:
  --user=USERNAME      existing Reqad account (must exist in accounts table)
  --domain=DOMAIN      the additional domain to add
  --docroot=PATH       document root (default: /home/<user>/<domain>)
  --docroot-ready      the document root was made by the caller AS the account
                       (the account panel, the API): nothing is created or
                       written inside the home folder by root; a folder right
                       under the home only gets the web server's group
  --php=VERSION        PHP version to use (default: system default)
  --handler=HANDLER    mod_php or fpm (apache default: mod_php; nginx: fpm only)
  --no-www             do not add "www.<domain>" to the vhost
  --no-ssl             create only the :80 vhost (no https vhost, no cert)
  --letsencrypt        try to obtain a Let's Encrypt cert after the vhost is up
  --dry-run            print what would be done, write nothing
  -h, --help           this help

Examples:
  $0 --user=example --domain=test.example.com --php=7.4 --handler=mod_php
  $0 --user=example --domain=shop.example.com --php=8.3
EOF
}

for arg in "$@"; do
    case "$arg" in
        --user=*)     USER="${arg#*=}" ;;
        --domain=*)   DOMAIN="${arg#*=}" ;;
        --docroot=*)  DOCROOT="${arg#*=}" ;;
        --docroot-ready) DOCROOT_READY=1 ;;
        --php=*)      PHPVER="${arg#*=}" ;;
        --handler=*)  HANDLER="${arg#*=}" ;;
        --no-www)     WWW=0 ;;
        --no-ssl)     SSL=0 ;;
        --letsencrypt) LETSENCRYPT=1 ;;
        --dry-run)    DRYRUN=1 ;;
        -h|--help)    usage; exit 0 ;;
        *)            echo "Error: unknown argument '$arg'"; usage; exit 1 ;;
    esac
done

die() { echo "Error: $*" >&2; exit 1; }
run() {
    if [ "$DRYRUN" -eq 1 ]; then echo "+ $*"; else "$@"; fi
}

[ "$(id -u)" -eq 0 ] || die "You can only run this script as root."
[ -n "$USER" ] && [ -n "$DOMAIN" ] || { usage; exit 1; }
[ -f "$DB" ] || die "Missing SQLite database $DB"

DOMAIN="${DOMAIN,,}"

# ---------------------------------------------------------------- validation
[[ "$USER" =~ ^[a-z][a-z0-9]{1,15}$ ]] \
    || die "Username must be 2-16 characters, lowercase letters and numbers, starting with a letter."
[[ "$DOMAIN" =~ ^([a-z0-9]([a-z0-9-]*[a-z0-9])?\.)+[a-z]{2,}$ ]] \
    || die "Domain name '$DOMAIN' is not valid."

# .sqliterc forces box mode, so query with -batch -noheader -list
sq() { sqlite3 -batch -noheader -list "$DB" "$1"; }

[ "$(sq "SELECT count(*) FROM accounts WHERE user='${USER//\'/\'\'}'")" = "1" ] \
    || die "Account '$USER' does not exist in Reqad."
id "$USER" >/dev/null 2>&1 || die "System user '$USER' does not exist."
# plan limits (hosting packages): core allows everything, a plugin may not
LIMIT_MSG=$(/usr/local/reqad/bin/reqad account can-create "$USER" addon --domain="$DOMAIN" 2>&1) || die "${LIMIT_MSG#reqad: }"

OWNER_OF_DOMAIN="$(sq "SELECT user FROM accounts WHERE domain='${DOMAIN//\'/\'\'}'")"
[ -z "$OWNER_OF_DOMAIN" ] \
    || die "'$DOMAIN' is already the main domain of account '$OWNER_OF_DOMAIN'."

# --------------------------------------------------------------- web server
. "${PATH_REQAD}/scripts/web_caps.sh"
WEB_CAPS_ROOT="$PATH_REQAD" web_caps "$INI"
[ -n "$WEB_FRONT" ] || die "Unknown web server template '$TEMPLATE' in $INI."
# Apache behind nginx: a second vhost on loopback (web_backend_addr() in app/functions)
BACKEND_VHOST=''
if [ "$WEB_BACKEND" != none ]; then
    command -v httpd >/dev/null 2>&1 || die "httpd (the backend web server) is not installed."
    BACKEND_VHOST="$(web_vhost_dir "$WEB_BACKEND")/${DOMAIN}.conf"
    [ -e "$BACKEND_VHOST" ] && die "Backend vhost file $BACKEND_VHOST already exists."
fi
case "$WEB_FRONT" in
    httpd)
        WEBSERVER='apache'
        WEB_SERVICE='httpd'
        command -v httpd >/dev/null 2>&1 || die "httpd is not installed."
        ;;
    nginx)
        WEBSERVER='nginx'
        WEB_SERVICE='nginx'
        command -v nginx >/dev/null 2>&1 || die "nginx is not installed."
        ;;
esac
VHOST="$(web_vhost_dir "$WEB_FRONT")/${DOMAIN}.conf"
# docroot + socket group: the front server's (a backend server is a member)
FPM_GROUP="$(web_user "$WEB_FRONT")"
[ -e "$VHOST" ] && die "Vhost file $VHOST already exists."

# ---------------------------------------------------------------- php setup
PHP_DEFAULT="$(grep -E '^[[:space:]]*php[[:space:]]*=' "$INI" | head -n1 | cut -d= -f2 | tr -d '[:space:]')"
PHP_AVAILABLE="$(grep -E '^[[:space:]]*php_versions[[:space:]]*=' "$INI" | head -n1 | cut -d= -f2 | tr -d '[:space:]')"
[ -n "$PHP_DEFAULT" ] || die "No 'php=' entry in $INI (run scripts/update_php_versions)."
[ -n "$PHPVER" ] || PHPVER="$PHP_DEFAULT"

echo ",${PHP_AVAILABLE}," | grep -q ",${PHPVER}," \
    || die "PHP $PHPVER is not installed. Available: ${PHP_AVAILABLE}"

PHP_SHORT="${PHPVER//./}"
IS_DEFAULT_PHP=0
[ "$PHPVER" = "$PHP_DEFAULT" ] && IS_DEFAULT_PHP=1

# mod_php templates default to it (that is what the account templates use), the rest are fpm only
if [ -z "$HANDLER" ]; then
    [ "$PHP_MODE" = 'modphp' ] && HANDLER='mod_php' || HANDLER='fpm'
fi
case "$HANDLER" in
    mod_php|fpm) ;;
    *) die "--handler must be 'mod_php' or 'fpm'." ;;
esac
[ "$PHP_MODE" = 'fpm' ] && [ "$HANDLER" = 'mod_php' ] \
    && die "This server's template ($TEMPLATE) has no mod_php. Use --handler=fpm (the default here)."

# mod_php only exists for the distro/default PHP; the remi SCL builds are fpm only.
if [ "$HANDLER" = "mod_php" ] && [ "$IS_DEFAULT_PHP" -eq 0 ]; then
    die "mod_php is only available for the default PHP ($PHP_DEFAULT). Use --handler=fpm for PHP $PHPVER."
fi

# Which <IfModule> guard matches the loaded mod_php, so the vhost stays valid
# on a server where mod_php is not installed at all.
PHP_MODULE=''
if [ "$HANDLER" = "mod_php" ]; then
    LOADED="$(httpd -M 2>/dev/null | grep -oE 'php[0-9]*_module' | head -n1)"
    case "$LOADED" in
        php7_module) PHP_MODULE='mod_php7.c' ;;
        php5_module) PHP_MODULE='mod_php5.c' ;;
        php_module)  PHP_MODULE='mod_php.c' ;;
        *) die "mod_php is not loaded in apache (httpd -M shows no php module). Use --handler=fpm." ;;
    esac
fi

[ -n "$DOCROOT" ] || DOCROOT="/home/${USER}/${DOMAIN}"
case "$DOCROOT" in
    /home/${USER}/*) ;;
    *) die "Document root must live under /home/${USER}/ (open_basedir is /home/${USER})." ;;
esac
# not inside a site deployed from Git: its document root is a symlink into
# ~/apps/<domain>/current, replaced on every deploy (app/functions/deploy.php)
case "$(readlink -m "$DOCROOT")" in
    /home/${USER}/apps/*) die "$DOCROOT is inside a site deployed from Git (Accounts > Deployments); the next deploy would remove it. Choose a document root outside it." ;;
esac

if [ "$HANDLER" = "fpm" ]; then
    if [ "$IS_DEFAULT_PHP" -eq 1 ]; then
        POOL="/etc/php-fpm.d/${DOMAIN}.conf"
        FPM_SERVICE="php-fpm.service"
    else
        POOL="/etc/opt/remi/php${PHP_SHORT}/php-fpm.d/${DOMAIN}.conf"
        FPM_SERVICE="php${PHP_SHORT}-php-fpm.service"
    fi
    [ -d "$(dirname "$POOL")" ] || die "Missing $(dirname "$POOL") — is php${PHP_SHORT}-php-fpm installed?"
    [ -e "$POOL" ] && die "PHP-FPM pool $POOL already exists."
    # per-domain socket: the account's main domain already owns /run/php-fpm-<user>.sock
    SOCKET="/run/php-fpm-${USER}-${DOMAIN}.sock"
    UPSTREAM="php-fpm-${USER}-${DOMAIN}"
else
    POOL=''
    FPM_SERVICE=''
    SOCKET=''
    UPSTREAM=''
fi

# "#SKIP" lines are filtered out when the file is written, so an empty alias
# leaves no blank line behind.
SERVER_ALIAS="#SKIP"
[ "$WWW" -eq 1 ] && SERVER_ALIAS="    ServerAlias    www.${DOMAIN}"
NAMES="$DOMAIN"
[ "$WWW" -eq 1 ] && NAMES="${DOMAIN} www.${DOMAIN}"

echo "Account .......... ${USER}"
echo "Additional domain  ${DOMAIN}"
echo "Web server ....... ${WEBSERVER} (${TEMPLATE})"
echo "Document root .... ${DOCROOT}"
echo "PHP .............. ${PHPVER} (${HANDLER})"
[ -n "$POOL" ] && echo "PHP-FPM pool ..... ${POOL} → ${SOCKET}"
echo "Vhost ............ ${VHOST}"
[ -n "$BACKEND_VHOST" ] && echo "Backend vhost .... ${BACKEND_VHOST}"
echo

# ------------------------------------------------------------- document root
if [ "$DOCROOT_READY" -eq 1 ]; then
    # made as the account: root writes nothing inside the home (a symlink
    # swapped in could lead it anywhere). chgrp -h follows no link, and a
    # folder right under the home has no path part the account could swap.
    [ -d "$DOCROOT" ] && [ ! -L "$DOCROOT" ] || die "Document root $DOCROOT is not a folder."
    [ "$(stat -c %U "$DOCROOT")" = "$USER" ] || die "Document root $DOCROOT does not belong to ${USER}."
    if [ "$(dirname "$DOCROOT")" = "/home/${USER}" ]; then
        run chgrp -h "$FPM_GROUP" "$DOCROOT"
    fi
elif [ ! -d "$DOCROOT" ]; then
    run mkdir -p "$DOCROOT"
    # only the account and the web server reach it (harden_account_perms.sh)
    run chown "${USER}:${FPM_GROUP}" "$DOCROOT"
    run chmod 0750 "$DOCROOT"
fi
for d in "/home/${USER}/logs" "/home/${USER}/tmp"; do
    if [ "$DOCROOT_READY" -eq 0 ] && [ ! -d "$d" ]; then
        run mkdir -p "$d"
        run chown "${USER}:${USER}" "$d"
        run chmod 0770 "$d"
    fi
done
run chmod a+x "/home/${USER}"

if [ "$DOCROOT_READY" -eq 0 ] && [ ! -e "${DOCROOT}/index.php" ] && [ ! -e "${DOCROOT}/index.html" ]; then
    if [ "$DRYRUN" -eq 1 ]; then
        echo "+ install default index.php in ${DOCROOT}"
    else
        cp "${PATH_REQAD}/scripts/templates/default-template.html" "${DOCROOT}/index.php"
        chown "${USER}:${USER}" "${DOCROOT}/index.php"
    fi
fi

# ----------------------------------------------------------------- ssl certs
# LE_LIVE is set when a Let's Encrypt cert already exists for this domain.
LE_LIVE=0
CERT_CRT=''
CERT_KEY=''
CERT_CHAIN=''
if [ "$SSL" -eq 1 ]; then
    if [ -f "/etc/letsencrypt/live/${DOMAIN}/cert.pem" ]; then
        LE_LIVE=1
        CERT_CRT="/etc/letsencrypt/live/${DOMAIN}/fullchain.pem"
        CERT_KEY="/etc/letsencrypt/live/${DOMAIN}/privkey.pem"
        CERT_CHAIN="/etc/letsencrypt/live/${DOMAIN}/chain.pem"
    else
        if [ ! -f "/etc/ssl/certs/${DOMAIN}.crt" ] || [ ! -f "/etc/ssl/certs/${DOMAIN}.key" ]; then
            run "${PATH_REQAD}/scripts/genselfsigned.sh" "$DOMAIN"
        fi
        if [ "$DRYRUN" -eq 0 ] && { [ ! -f "/etc/ssl/certs/${DOMAIN}.crt" ] || [ ! -f "/etc/ssl/certs/${DOMAIN}.key" ]; }; then
            echo "Warning: could not create a self-signed certificate, skipping the https vhost."
            SSL=0
        else
            CERT_CRT="/etc/ssl/certs/${DOMAIN}.crt"
            CERT_KEY="/etc/ssl/certs/${DOMAIN}.key"
        fi
    fi
fi

# ------------------------------------------------------------ apache vhost
# Apache reading the files as apache (php-fpm templates): links only to files
# of the same owner, and .htaccess cannot turn FollowSymLinks back on
# (apache_override_options() in app/functions/accounts.php). With mod_php,
# mod_ruid2 runs the request as the account already.
SYMLINK_OPTS='Options=Indexes,MultiViews,SymLinksIfOwnerMatch,IncludesNOEXEC'
if [ "$PHP_MODE" = fpm ]; then
    APACHE_OVERRIDE=" ${SYMLINK_OPTS}"; APACHE_FOLLOW=''
else
    APACHE_OVERRIDE=''; APACHE_FOLLOW=' FollowSymLinks'
fi
apache_php_block() {
    if [ "$HANDLER" = "fpm" ]; then
        cat <<EOF
    <FilesMatch \\.php\$>
        SetHandler "proxy:unix:${SOCKET}|fcgi://localhost"
    </FilesMatch>
EOF
    else
        cat <<EOF
    <IfModule ${PHP_MODULE}>
        php_admin_value open_basedir          /home/${USER}
        php_admin_value disable_functions     show_source,system,shell_exec,passthru,exec,popen,proc_open
        php_admin_value error_log             /home/${USER}/logs/${DOMAIN}-error.log
        php_admin_flag  log_errors            on
        php_admin_value sys_temp_dir          /home/${USER}/tmp
        php_admin_value upload_tmp_dir        /home/${USER}/tmp
        php_admin_value memory_limit          2048M
        php_value       session.save_handler  files
        php_value       session.save_path     /home/${USER}/tmp
    </IfModule>
EOF
    fi
}

apache_vhost_body() {
    cat <<EOF
<Directory "${DOCROOT}">
    AllowOverride All${APACHE_OVERRIDE}
    Options MultiViews SymLinksIfOwnerMatch IncludesNoExec${APACHE_FOLLOW}
    Require all granted
</Directory>

    ServerAdmin    webmaster@${DOMAIN}
    ServerName     ${DOMAIN}
${SERVER_ALIAS}
    DocumentRoot   ${DOCROOT}
    UseCanonicalName Off
    Options -ExecCGI -Includes
    ErrorLog logs/error_log
    CustomLog logs/${DOMAIN}_log combined
    <IfModule mod_ruid2.c>
        RUidGid ${USER} ${USER}
    </IfModule>

$(apache_php_block)
EOF
}

apache_vhost() {
    echo "<VirtualHost 0.0.0.0:80>"
    if [ "$SSL" -eq 1 ]; then
        # http vhost only redirects to https
        cat <<EOF
    ServerName     ${DOMAIN}
${SERVER_ALIAS}
    DocumentRoot   ${DOCROOT}
    ErrorLog logs/error_log
    CustomLog logs/${DOMAIN}_log combined
    RewriteEngine on
    RewriteCond %{SERVER_NAME} =${DOMAIN}$([ "$WWW" -eq 1 ] && echo " [OR]")
$([ "$WWW" -eq 1 ] && echo "    RewriteCond %{SERVER_NAME} =www.${DOMAIN}" || echo "#SKIP")
    RewriteRule ^ https://%{SERVER_NAME}%{REQUEST_URI} [END,NE,R=permanent]
EOF
    else
        apache_vhost_body
    fi
    echo "</VirtualHost>"

    if [ "$SSL" -eq 1 ]; then
        echo
        echo "<IfModule mod_ssl.c>"
        echo "<VirtualHost 0.0.0.0:443>"
        apache_vhost_body
        echo "    SSLEngine on"
        [ -f /etc/letsencrypt/options-ssl-apache.conf ] && echo "    Include /etc/letsencrypt/options-ssl-apache.conf" || echo "#SKIP"
        echo "    SSLCertificateFile ${CERT_CRT}"
        echo "    SSLCertificateKeyFile ${CERT_KEY}"
        [ -n "$CERT_CHAIN" ] && echo "    SSLCertificateChainFile ${CERT_CHAIN}" || echo "#SKIP"
        echo "</VirtualHost>"
        echo "</IfModule>"
    fi
}

# ------------------------------------------------------------- nginx vhost
nginx_server_body() {
    cat <<EOF
    error_log  /var/log/nginx/${DOMAIN}_log;
    access_log /var/log/nginx/${DOMAIN}_log;

    root        ${DOCROOT};
    autoindex   off;
    index       index.php index.html index.htm;
$([ -f /etc/nginx/reqad-error-pages.conf ] && echo "    include /etc/nginx/reqad-error-pages.conf;" || echo "#SKIP")

    # Allow OPTIONS for Wordpress
    allow_methods "^(GET|POST|HEAD|OPTIONS)\$";

    location / {

        # wordpress rewrite
        location /wp-json {
            rewrite ^/wp-json(.*)\$ /?rest_route=\$1;
        }

        try_files \$uri \$uri/ /index.php\$is_args\$args;

        # Deny all attempts to access hidden files such as .htaccess, .htpasswd, .DS_Store
        location ~ /\\. {
            deny all;
        }

        # Deny access to any files with a .php extension in the uploads directory
        # Works in sub-directory installs and also in multisite network
        # Must stay ABOVE the PHP handler: nested regex locations match in file
        # order, so placed after the .php location this deny never fired.
        location ~* /(?:uploads|files)/.*\\.php\$ {
            deny all;
        }

        location ~ \\.php\$ {
            try_files                   \$uri =404;
            fastcgi_split_path_info     ^(.+\\.php)(/.+)\$;
            fastcgi_intercept_errors    off;

            include         /etc/nginx/fastcgi_params;
            fastcgi_index   index.php;
            fastcgi_param   SCRIPT_FILENAME     \$realpath_root\$fastcgi_script_name;
            fastcgi_param   DOCUMENT_ROOT       \$realpath_root;
            fastcgi_pass    ${UPSTREAM};
        }

        location ~* \\.(js|css|png|jpg|jpeg|gif|ico|woff2)\$ {
            expires max;
            log_not_found off;
        }
        location = /favicon.ico {
            log_not_found off;
            access_log off;
        }

        location = /robots.txt {
            allow all;
            log_not_found off;
            access_log off;
        }
    }
EOF
}

# Apache behind nginx: nginx serves the static files and passes the rest to
# Apache. Keep in step with nginx_backend_root() / nginx_backend_named() in
# app/functions/accounts.php.
nginx_backend_body() {
    cat <<EOF
    error_log  /var/log/nginx/${DOMAIN}_log;
    access_log /var/log/nginx/${DOMAIN}_log;

    root        ${DOCROOT};
    autoindex   off;
    index       index.php index.html index.htm;
$([ -f /etc/nginx/reqad-error-pages.conf ] && echo "    include /etc/nginx/reqad-error-pages.conf;" || echo "#SKIP")

    # Allow OPTIONS for Wordpress
    allow_methods "^(GET|POST|HEAD|OPTIONS)\$";

    location / {
        # everything that is not a static file: Apache behind nginx (.htaccess, PHP)
        include /etc/nginx/reqad-backend.conf;

        # Deny all attempts to access hidden files such as .htaccess, .htpasswd, .DS_Store
        location ~ /\\. {
            deny all;
        }

        # Deny access to any files with a .php extension in the uploads directory
        # Must stay ABOVE the PHP location (nested regex locations match in file order).
        location ~* /(?:uploads|files)/.*\\.php\$ {
            deny all;
        }

        location ~ \\.php\$ {
            include /etc/nginx/reqad-backend.conf;
        }

        location ~* \\.(js|css|png|jpg|jpeg|gif|ico|woff2|woff|webp|avif|svg)\$ {
            try_files \$uri @reqad_backend;
            expires max;
            log_not_found off;
        }
        location ~* \\.(map|bmp|tif|tiff|ttf|otf|eot|mp4|webm|ogg|ogv|mp3|m4a|wav|flac|pdf|txt|xml|csv|zip|gz|tgz|rar|7z|doc|docx|xls|xlsx|ppt|pptx|odt|ods)\$ {
            try_files \$uri @reqad_backend;
        }
        location = /favicon.ico {
            try_files \$uri @reqad_backend;
            log_not_found off;
            access_log off;
        }
        location = /robots.txt {
            try_files \$uri @reqad_backend;
            allow all;
            log_not_found off;
            access_log off;
        }
    }

    location @reqad_backend {
        include /etc/nginx/reqad-backend.conf;
    }
EOF
}

# The domain's vhost on the backend Apache (backend_vhost() in app/functions/accounts.php).
backend_vhost() {
    local addr=127.0.0.1:8080 port=80
    [ "$SSL" -eq 1 ] && { addr=127.0.0.1:8443; port=443; }
    cat <<EOF
# Backend of additional domain ${DOMAIN} (account ${USER}) — generated by reqad adddomain on $(date '+%Y-%m-%d %H:%M:%S')
# Apache behind nginx: nginx serves the static files and passes the rest here.
<VirtualHost ${addr}>
    ServerName     ${DOMAIN}:${port}
    ServerAlias    ${NAMES}
    DocumentRoot   ${DOCROOT}
    UseCanonicalName Off
    <Directory "${DOCROOT}">
        AllowOverride All ${SYMLINK_OPTS}
        Options MultiViews SymLinksIfOwnerMatch IncludesNoExec
        Require all granted
    </Directory>
    Options -ExecCGI -Includes
EOF
    if [ "$SSL" -eq 1 ]; then
        cat <<EOF
    SSLEngine on
    SSLCertificateFile /etc/httpd/reqad-backend/backend.crt
    SSLCertificateKeyFile /etc/httpd/reqad-backend/backend.key
EOF
    fi
    cat <<EOF

    <FilesMatch \.php\$>
        SetHandler "proxy:unix:${SOCKET}|fcgi://localhost"
    </FilesMatch>
</VirtualHost>
EOF
}

nginx_vhost() {
    local body=nginx_server_body
    if [ -n "$BACKEND_VHOST" ]; then
        body=nginx_backend_body
    else
        cat <<EOF
upstream ${UPSTREAM} {
    server   unix:${SOCKET};
}

EOF
    fi
    if [ "$SSL" -eq 1 ]; then
        cat <<EOF
server {
    listen 80;
    access_log off;
    error_log off;
    server_name ${NAMES};
    return 301 https://\$host\$request_uri;
}

server {
    listen 443 ssl;
    http2 on;

    server_name ${NAMES};
    ssl_certificate ${CERT_CRT};
    ssl_certificate_key ${CERT_KEY};

$($body)
}
EOF
    else
        cat <<EOF
server {
    listen 80;
    server_name ${NAMES};

$($body)
}
EOF
    fi
}

# --------------------------------------------------------------- write files
TMP="$(mktemp /tmp/reqad-vhost.XXXXXX)"
{
    echo "# Additional domain of account ${USER} — generated by reqad adddomain on $(date '+%Y-%m-%d %H:%M:%S')"
    if [ "$WEBSERVER" = 'apache' ]; then
        apache_vhost
    else
        nginx_vhost
    fi
} | grep -v '^#SKIP$' > "$TMP"

if [ "$DRYRUN" -eq 1 ]; then
    echo "----- ${VHOST} -----"
    cat "$TMP"
    rm -f "$TMP"
    [ -n "$BACKEND_VHOST" ] && { echo "----- ${BACKEND_VHOST} -----"; backend_vhost; }
    [ -n "$POOL" ] && echo "----- ${POOL} would be created -----"
    exit 0
fi

install -m 0644 -o root -g root "$TMP" "$VHOST"
rm -f "$TMP"
echo "Wrote ${VHOST}"
if [ -n "$BACKEND_VHOST" ]; then
    TMP="$(mktemp /tmp/reqad-vhost.XXXXXX)"
    backend_vhost > "$TMP"
    install -m 0644 -o root -g root "$TMP" "$BACKEND_VHOST"
    rm -f "$TMP"
    echo "Wrote ${BACKEND_VHOST}"
fi

# --------------------------------------------------------------- fpm pool
if [ -n "$POOL" ]; then
    cat > "$POOL" <<EOF
[${DOMAIN}]
user = ${USER}
group = ${USER}
listen = ${SOCKET}
listen.owner = ${USER}
listen.group = ${FPM_GROUP}
listen.allowed_clients = 127.0.0.1

; workers start with the first request and stop after 10 s idle, so a quiet
; site holds no memory; 20 at once per site, a stuck script is killed at 300 s
pm = ondemand
pm.max_children = 20
pm.process_idle_timeout = 10s
pm.max_requests = 500
request_terminate_timeout = 300s

ping.path = /ping
slowlog = /var/log/php-fpm/${DOMAIN}-slow.log
chdir = /

php_admin_value[disable_functions] = show_source, system, shell_exec, passthru, exec, popen, proc_open
php_admin_value[open_basedir] = /home/${USER}
php_admin_value[error_log] = "/home/${USER}/logs/${DOMAIN}-error.log"
php_admin_flag[log_errors] = on
php_admin_value[sys_temp_dir] = "/home/${USER}/tmp"
php_admin_value[upload_tmp_dir] = "/home/${USER}/tmp"
php_admin_value[memory_limit] = 2048M
php_value[session.save_handler] = files
php_value[session.save_path] = "/home/${USER}/tmp"
php_value[soap.wsdl_cache_dir]  = /var/lib/php/wsdlcache
EOF
    chmod 0644 "$POOL"
    echo "Wrote ${POOL}"
fi

# ----------------------------------------------------------------- activate
rollback() {
    rm -f "$VHOST"
    [ -n "$BACKEND_VHOST" ] && rm -f "$BACKEND_VHOST"
    [ -n "$POOL" ] && rm -f "$POOL"
}

if [ "$WEBSERVER" = 'apache' ]; then
    CONFTEST="httpd -t"
else
    CONFTEST="nginx -t"
fi
if ! $CONFTEST >/dev/null 2>&1; then
    echo "Error: ${WEBSERVER} configuration test failed, rolling back:" >&2
    $CONFTEST 2>&1 | sed 's/^/    /' >&2
    rollback
    exit 1
fi
if [ -n "$BACKEND_VHOST" ] && ! httpd -t >/dev/null 2>&1; then
    echo "Error: httpd configuration test failed, rolling back:" >&2
    httpd -t 2>&1 | sed 's/^/    /' >&2
    rollback
    exit 1
fi

if [ -n "$FPM_SERVICE" ]; then
    if ! systemctl restart "$FPM_SERVICE"; then
        echo "Error: failed to restart ${FPM_SERVICE}, rolling back." >&2
        rollback
        systemctl restart "$FPM_SERVICE" >/dev/null 2>&1
        exit 1
    fi
    echo "Restarted ${FPM_SERVICE}"
fi
if [ -n "$BACKEND_VHOST" ]; then
    systemctl reload httpd 2>/dev/null || systemctl restart httpd || die "Failed to reload httpd."
    echo "Reloaded httpd"
fi
systemctl reload "$WEB_SERVICE" 2>/dev/null || systemctl restart "$WEB_SERVICE" || die "Failed to reload ${WEB_SERVICE}."
echo "Reloaded ${WEB_SERVICE}"

# -------------------------------------------------------------- letsencrypt
if [ "$LETSENCRYPT" -eq 1 ]; then
    if [ "$LE_LIVE" -eq 1 ]; then
        echo "A Let's Encrypt certificate already exists for ${DOMAIN}, nothing to do."
    else
        IP="$(/usr/sbin/ip address show | grep 'scope global' | grep 'inet ' | head -n 1 | awk '{print $2}' | awk -F/ '{print $1}')"
        LE_DOMAINS="$DOMAIN"
        [ "$WWW" -eq 1 ] && [ "$(dig +short a "www.${DOMAIN}" | tail -n1)" = "$IP" ] && LE_DOMAINS="${DOMAIN},www.${DOMAIN}"
        if [ "$(dig +short a "$DOMAIN" | tail -n1)" = "$IP" ]; then
            certbot --non-interactive --"${WEB_SERVICE/httpd/apache}" -d "$LE_DOMAINS" \
                && echo "Let's Encrypt certificate installed."
            # an https vhost certbot wrote to <domain>-le-ssl.conf goes into <domain>.conf
            [ "$WEB_SERVICE" = httpd ] && "${PATH_REQAD}/scripts/update/merge_le_ssl_vhosts.sh" --domain="$DOMAIN"
        else
            echo "Warning: ${DOMAIN} does not resolve to ${IP}, skipping Let's Encrypt."
        fi
    fi
fi

echo
echo "Additional domain ${DOMAIN} created for account ${USER}."
echo "Document root: ${DOCROOT}"
